# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 的托管段排除，**绝不会**进 Git；.env.example 本身可以提交。
# callLLM 读取的三个变量（OpenAI 兼容端点；API key 只走 env，绝不写入 book.json）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# gates 子进程的 Python 解释器（缺省：win32=python，其他=python3）
NOVEL_PYTHON=
# gates 子进程硬超时（ms，缺省 120000）。书越长全量扫描越慢；
# 超时会 SIGKILL 并以 kind='timeout' 失败，绝不会变成「永久 pending」。
NOVEL_GATE_TIMEOUT_MS=
# LLM 调用内部重试次数（缺省 1；设 0 = 只留单次请求）。本项目只允许这一层重试。
NOVEL_LLM_RETRY_ATTEMPTS=
# 熔断：连续可重试失败到该值即开路（缺省 3），冷却期内不再发任何请求
NOVEL_LLM_BREAKER_THRESHOLD=
# 熔断冷却时长（ms，缺省 60000）
NOVEL_LLM_BREAKER_COOLDOWN_MS=
# apps/server 监听端口（缺省 4319）
NOVEL_SERVER_PORT=
# apps/server 绑定地址（缺省 127.0.0.1，只回环）。设成 0.0.0.0 / 本机局域网 IP
# 会让同网段其他人也能连——只有确实需要时才改，且务必配 NOVEL_SERVER_TOKEN。
NOVEL_SERVER_HOST=
# apps/server 鉴权 token。留空则每次启动随机生成并打到启动日志（重启即失效）。
# 想固定下来便于反复使用，就在这里写死一个长随机串。
NOVEL_SERVER_TOKEN=
# apps/server 可写/可读根边界。设了之后所有请求的 bookRoot 必须落在其内。
NOVEL_ALLOWED_ROOT=
# apps/server 写盘总开关。留空=关闭（只读面板）；要开须同时配好 NOVEL_ALLOWED_ROOT。
NOVEL_ALLOW_WRITE=
